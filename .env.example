# Copy to .env.local and fill in. Never commit real values.

# Shared secret Vaani sends on every custom-tool and webhook call (header x-vaani-secret)
VAANI_TOOL_SECRET=

# Google Calendar, option A (used here: MESA blocks service-account keys): OAuth "Desktop app" client.
# Fill in the client id/secret, then `npm run google:auth` signs in once and writes the refresh token
# (and creates the two test designer calendars).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Option B: service account; each designer shares their calendar with it ("Make changes to events")
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Gemini Flash (classification + extraction)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Free tier = 20 requests/day per model; these are tried in order when the main model's daily quota is used up
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite

# HubSpot private app access token (Settings → Integrations → Private apps / Legacy apps)
HUBSPOT_PRIVATE_APP_TOKEN=
# Optional: override the deal pipeline/stage (free plan has one pipeline: "default", stage "appointmentscheduled")
HUBSPOT_PIPELINE_ID=
HUBSPOT_DEALSTAGE_ID=

# End-of-call webhook. Optional HMAC secret if Vaani signs webhooks (Settings → Webhooks); defaults to VAANI_TOOL_SECRET.
VAANI_WEBHOOK_SECRET=
# Log full webhook payloads (needed to build the parser; set false afterwards: transcripts are personal data)
VAANI_LOG_PAYLOADS=true


# Telegram bot (designers) + Nikhil's chat for complaint alerts
TELEGRAM_BOT_TOKEN=
# Any long random string; Telegram sends it back on every update so we know the request is real
TELEGRAM_WEBHOOK_SECRET=
NIKHIL_TELEGRAM_CHAT_ID=

# Resend (client confirmation email, only when the caller asks)
RESEND_API_KEY=
# Until you verify a domain in Resend, use "Aangan Studio <onboarding@resend.dev>"; it only delivers to your own Resend login email.
EMAIL_FROM="Aangan Studio <hello@yourdomain.in>"
# Where client replies ("reply to reschedule") should land
EMAIL_REPLY_TO=

# Supabase (state: designers, chat ids, round-robin pointer, call log)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Dashboard access for Rahul
DASHBOARD_PASSCODE=

# Designers: only used when Supabase is NOT configured (local testing). With Supabase, the `designers` table wins.
DESIGNERS_JSON='[{"code":"designer1","name":"Ananya","calendarId":"designer1@example.com"},{"code":"designer2","name":"Rohan","calendarId":"designer2@example.com"}]'

# Booking defaults
STUDIO_ADDRESS="Aangan Studio, Pune"
MIN_LEAD_MINUTES=120
BOOKING_DAYS_AHEAD=7
MEETING_MINUTES=30
BOOKING_HOURS="Mon-Sat 10:00-18:00"
TIMEZONE=Asia/Kolkata
# Calls outside these hours count as after-hours on the dashboard
FRONT_DESK_HOURS="Mon-Sat 10:00-19:00"
